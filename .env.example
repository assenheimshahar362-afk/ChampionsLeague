# ---------------------------------------------------------------- Supabase --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------ Football-Data.org --
# Register at https://www.football-data.org/client/register and keep this token
# server-only. Requests authenticate with X-Auth-Token.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Season to ingest, numbered by the year it STARTS in: 2024 = 2024/25.
# Use 2026 for the live 2026/27 campaign. Use 2024 with rebasing for a replay.
FOOTBALL_DATA_SEASON=2026

# ----------------------------------------------------------- Season replay --
# Season 2024 has already been played, so every fixture is in the past and
# permanently locked. Rebasing replays it on a timeline starting now, which is
# what makes the predict -> lock -> live -> settle loop exercisable.
#
# FOR A LIVE 2026/27 SUBSCRIPTION: set REBASE_ENABLED=false. The provider's
# kickoffs are already correct and must be used untouched.
REBASE_ENABLED=false
# The real season instant that maps onto ingest time. Fixtures before it land
# in the past (settled), fixtures after it in the future (open to predict).
# The default sits just after League Stage 2.
REBASE_PIVOT=2024-10-03T00:00:00.000Z
# Time compression. 1 = real time (an 8.5-month season); 0.04 = ~10 days.
REBASE_SCALE=0.04

# -------------------------------------------------------------------- Cron --
CRON_SECRET=

# --------------------------------------------------------------------- App --
# OPTIONAL. The origin is taken from the request Host header, and on Vercel from
# VERCEL_URL if that is ever missing. Set this only to force a specific origin.
NEXT_PUBLIC_APP_URL=

# Comma-separated emails allowed to open /admin and run admin actions.
APP_ADMIN_EMAILS=
